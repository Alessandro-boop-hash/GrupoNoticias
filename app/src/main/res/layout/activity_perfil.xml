<?xml version="1.0" encoding="utf-8"?>
<!-- ===================== PANTALLA 3: PERFIL =====================
     Barra de opciones superior (atras, buscar, correo y menu desplegable),
     ficha del usuario y boton de cierre de sesion. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contenedorPerfil"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barraPerfil"
        style="@style/Widget.Noticias.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/alto_barra"
        app:navigationIcon="@drawable/ic_regresar"
        app:navigationIconTint="@color/azul_marino"
        app:title="@string/perfil_titulo" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/margen_horizontal"
            android:paddingEnd="@dimen/margen_horizontal"
            android:paddingTop="24dp">

            <!-- Avatar -->
            <FrameLayout
                android:layout_width="@dimen/tamano_avatar"
                android:layout_height="@dimen/tamano_avatar"
                android:background="@drawable/bg_avatar_circulo"
                android:contentDescription="@string/perfil_nombre">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/perfil_nombre"
                    android:src="@drawable/ic_persona"
                    app:tint="@color/azul_marino" />
            </FrameLayout>

            <!-- Nombre y ubicacion -->
            <TextView
                android:id="@+id/nombreUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/separacion"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/perfil_nombre"
                android:textColor="@color/azul_marino"
                android:textSize="@dimen/texto_titulo"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="@dimen/texto_titulo"
                app:autoSizeMinTextSize="15sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@string/perfil_ubicacion"
                    android:src="@drawable/ic_ubicacion"
                    app:tint="@color/azul_marino" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/perfil_ubicacion"
                    android:textColor="@color/azul_marino"
                    android:textSize="@dimen/texto_pequeno"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Opciones de la cuenta -->
            <LinearLayout
                android:id="@+id/opcionInformacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:layout_width="@dimen/tamano_icono"
                    android:layout_height="@dimen/tamano_icono"
                    android:contentDescription="@string/perfil_opcion_informacion"
                    android:src="@drawable/ic_informacion"
                    app:tint="@color/azul_marino" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/perfil_opcion_informacion"
                    android:textAppearance="@style/TextAppearance.Noticias.Etiqueta"
                    android:textSize="@dimen/texto_subtitulo" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/opcionNotificaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:layout_width="@dimen/tamano_icono"
                    android:layout_height="@dimen/tamano_icono"
                    android:contentDescription="@string/perfil_opcion_notificaciones"
                    android:src="@drawable/ic_notificaciones"
                    app:tint="@color/azul_marino" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/perfil_opcion_notificaciones"
                    android:textAppearance="@style/TextAppearance.Noticias.Etiqueta"
                    android:textSize="@dimen/texto_subtitulo" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/opcionFavoritos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:layout_width="@dimen/tamano_icono"
                    android:layout_height="@dimen/tamano_icono"
                    android:contentDescription="@string/perfil_opcion_favoritos"
                    android:src="@drawable/ic_favoritos"
                    app:tint="@color/azul_marino" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/perfil_opcion_favoritos"
                    android:textAppearance="@style/TextAppearance.Noticias.Etiqueta"
                    android:textSize="@dimen/texto_subtitulo" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Cierre de sesion -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonCerrarSesion"
        style="@style/Widget.Noticias.Boton"
        android:layout_marginStart="@dimen/margen_horizontal"
        android:layout_marginEnd="@dimen/margen_horizontal"
        android:layout_marginBottom="@dimen/margen_vertical"
        android:text="@string/perfil_boton_cerrar" />

</LinearLayout>